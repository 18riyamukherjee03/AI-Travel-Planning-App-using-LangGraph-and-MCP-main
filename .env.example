# ========================================================
# AI Travel Planning System (Part 2: LangGraph + MCP)
# Environment Configuration
# ========================================================

# LLM Provider (Groq Cloud - https://console.groq.com)
GROQ_API_KEY=your_groq_api_key_here

# Tavily Search API (https://tavily.com)
TAVILY_API_KEY=your_tavily_api_key_here

# AviationStack Flight API (https://aviationstack.com)
AVIATIONSTACK_API_KEY=your_aviationstack_api_key_here

# OpenWeatherMap API (https://openweathermap.org)
OPENWEATHER_API_KEY=your_openweather_api_key_here

# PostgreSQL Database (Optional - in-memory checkpointer is used if unset)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/langgraph_memory_demo
